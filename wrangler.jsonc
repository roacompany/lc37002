// Cloudflare Workers 배포 설정: 빌드 결과(dist/)를 정적 사이트로 서비스한다.
// Cloudflare의 Git 연동 빌드에서 Build command `npm run build`, Deploy command `npx wrangler deploy`로 사용.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Cloudflare 대시보드의 Worker 이름과 같아야 한다
  "name": "lc37002",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  }
}
